#!/bin/bash
# Launches the agent sidebar (run by hypr/sidebar.lua) with your Omarchy default
# coding agent (`omarchy default agent`).
#   agent-sidebar launch   open the sidebar
#   agent-sidebar new      start a fresh session (SUPER + SHIFT + A), asking for
#                          its name (empty keeps the timestamp)
#   agent-sidebar load     pick an earlier session, Claude only (SUPER + ALT + A)
#
# Any agent runs through Omarchy's own launcher (`omarchy-agent --inline`), so it
# starts exactly as SUPER + SHIFT + CTRL + A starts it. Claude Code is the
# exception: that launcher can't pass session options, so Claude is run
# directly to keep the sidebar pinned to one session (closing the window and
# relaunching resumes the same conversation) and to name new sessions (a name
# you give, or a timestamp) so they can be found again here or in Claude's
# /resume picker.

class=${SIDEBAR_AGENT_CLASS:-sidebar.agent}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
state_dir=$state_home/omarchy-sidebar/agent
claude_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}

notify() {
  notify-send -a Sidebar -- "Agent sidebar" "$1" 9>&-
}

# Starting the agent raises the dim behind sidebars ahead of it showing (see
# hypr/sidebar.lua). However this ends (a cancelled menu, a failed start, the
# agent up), have the plugin set it for what actually shows.
settle() {
  hyprctl eval 'if sidebar and sidebar.settle then sidebar.settle() end' >/dev/null 2>&1 9>&-
}
trap settle EXIT

for cmd in jq flock hyprctl; do
  if ! command -v "$cmd" >/dev/null; then
    notify "Needs $cmd, which isn't installed"
    exit 1
  fi
done

agent=$(omarchy-default-agent)
if [[ -z $agent ]]; then
  # Omarchy ships without a default; offer the choice instead of doing nothing.
  settle
  exec omarchy-menu summon setup.default.agent
fi
if omarchy-cmd-missing "$agent"; then
  notify "$agent (the Omarchy default agent) isn't installed. Choose another with: omarchy default agent <name>"
  exit 1
fi

# Agents keep sessions per directory; run where Omarchy's launcher does, so the
# folder is trusted and sessions land in one place.
work_dir=$HOME
[[ -d $HOME/Work ]] && work_dir=$HOME/Work

# Claude's folder for this directory's sessions: every character other than
# an ASCII letter or digit becomes "-".
projects=$claude_dir/projects/$(perl -CS -pe 's/[^a-zA-Z0-9\n]/-/g' <<<"$work_dir")

# One instance at a time: a second run while the sidebar is still starting
# would launch a second agent (on the same session, for Claude). The lock is
# released while the session menu is open, so a menu that never answers can't
# lock the keys out.
mkdir -p "$state_dir" && exec 9>"$state_dir/lock" || {
  notify "Can't write to $state_dir"
  exit 1
}
if ! flock -n 9; then
  [[ ${1:-launch} == launch ]] || notify "Still starting the sidebar; try again in a moment"
  exit 0
fi

windows() {
  hyprctl clients -j | jq -r --arg c "$class" '.[] | select(.class == $c) | .address'
}

window_open() {
  [[ -n $(windows) ]]
}

# Fails (and says so) if the window won't close, so callers don't switch
# sessions and launch a second sidebar next to it.
close_window() {
  local address
  for address in $(windows); do
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null
  done
  for _ in {1..30}; do window_open || return 0; sleep 0.1; done
  notify "The sidebar didn't close; leaving it as is"
  return 1
}

valid_uuid() {
  [[ $1 =~ ^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$ ]]
}

# Sessions this sidebar started, by id: the session picker lists these whatever
# their names (older ones are recognised by their timestamp names).
sessions_file=$state_dir/sessions

# A new session, named $1 (default: the date and time).
new_session() {
  local id name=${1:-}
  [[ -n $name ]] || name=$(date '+%Y-%m-%d %H:%M')
  id=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)
  id=${id,,}
  echo "$id" >"$state_dir/session-id"
  echo "$name" >"$state_dir/session-name"
  echo "$id" >>"$sessions_file"
}

# Asks for the new session's name (SUPER + SHIFT + A). Empty (or Escape, which
# the menu reports the same way) keeps the timestamp. Sets new_name.
ask_name() {
  local default answer
  default=$(date '+%Y-%m-%d %H:%M')
  new_name=$default
  flock -u 9
  answer=$(timeout 600 omarchy-menu-input "Name the new session (empty: $default)" --width 500 9>&-)
  [[ $? == 124 ]] && omarchy menu close >/dev/null 2>&1 9>&-
  if ! flock -w 5 9; then
    notify "The sidebar was busy starting; try again"
    return 1
  fi
  # One line, no surrounding spaces, at most 80 characters.
  answer=${answer//$'\n'/ }
  answer=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<<"$answer")
  [[ -n $answer ]] && new_name=${answer:0:80}
  return 0
}

# Claude's transcript for a session in the sidebar's folder (Claude only resumes
# a session from the directory it was started in).
transcript() {
  [[ -f $projects/$1.jsonl ]] && echo "$projects/$1.jsonl"
}

# Lists the newest sidebar sessions as a searchable menu and
# sets picked_id/picked_name. Returns 1 if nothing was picked.
pick_session() {
  local current f id title titles prompt key choice count=0
  local -A ids=() ours=()
  local options=()
  current=$(cat "$state_dir/session-id" 2>/dev/null)
  if [[ -f $sessions_file ]]; then
    while IFS= read -r id; do
      [[ -n $id ]] && ours[$id]=1
    done <"$sessions_file"
  fi

  while IFS= read -r f; do
    # The last title wins (a session can be renamed). One grep pass over the
    # file: reversing whole transcripts to find it was slow with large ones.
    titles=$(grep -F '"type":"custom-title"' "$f" | jq -r '.customTitle // empty' 2>/dev/null)
    title=$(tail -n1 <<<"$titles")
    id=$(basename "$f" .jsonl)
    # Started here: listed in sessions_file, or (older ones) first named by
    # timestamp; the first name counts, so a later /rename keeps it listed.
    [[ -n ${ours[$id]:-} || $(head -n1 <<<"$titles") =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || continue
    [[ -n $title ]] || title=${id:0:8}
    # Sessions without a message can't be resumed; leave them out.
    grep -q '"type":"user"' "$f" || continue
    # The session's typed prompts, newest first: the menu shows the start of
    # this line and searches all of it. Lines that don't parse (one being
    # written right now) are skipped rather than failing the whole file.
    prompt=$(grep '"type":"user"' "$f" |
      jq -nrR '[inputs | fromjson? | select(.type == "user" and .isMeta != true and (.message.content | type) == "string")
                | .message.content | select(startswith("<") | not) | gsub("\\s+"; " ")]
               | reverse | join(" · ") | .[0:500]' 2>/dev/null)
    # A row needs text under its title to be pickable.
    [[ -n $prompt ]] || prompt="(no typed prompts)"
    [[ $id == "$current" ]] && prompt="(current) $prompt"
    key="$title"$'\t'"$prompt"
    # Same minute, same prompts: tell them apart.
    [[ -n ${ids[$key]:-} ]] && key+=" · ${id:0:8}"
    ids[$key]=$id
    options+=("󰍩"$'\t'"$key")
    # The menu receives every option in a single argument, which has a size limit.
    ((++count >= 50)) && break
  done < <(ls -t "$projects"/*.jsonl 2>/dev/null | head -300)

  if ((${#options[@]} == 0)); then
    notify "No saved sidebar sessions yet"
    return 1
  fi

  flock -u 9
  choice=$(timeout 600 omarchy-menu-select "Claude sessions" "${options[@]}" -- --width 600 --maxheight 600 9>&-)
  case $? in
  0) ;;
  124)
    omarchy menu close >/dev/null 2>&1 9>&-
    return 1
    ;;
  *) return 1 ;;
  esac
  if ! flock -w 5 9; then
    notify "The sidebar was busy starting; pick the session again"
    return 1
  fi
  [[ -n $choice && -n ${ids[$choice]:-} ]] || return 1
  picked_id=${ids[$choice]}
  picked_name=${choice%%$'\t'*}
}

case ${1:-launch} in
launch)
  # The toggle key only launches when no sidebar exists; don't add a second.
  window_open && exit 0
  ;;
new)
  if [[ $agent == claude ]]; then
    ask_name || exit 1
    close_window || exit 1
    new_session "$new_name"
  else
    close_window || exit 1
  fi
  ;;
load)
  if [[ $agent != claude ]]; then
    notify "Saved sessions are only available with Claude Code"
    exit 0
  fi
  pick_session || exit 0
  if [[ $picked_id == "$(cat "$state_dir/session-id" 2>/dev/null)" ]] && window_open; then
    hyprctl eval 'sidebar.show("agent")' >/dev/null
    exit 0
  fi
  close_window || exit 1
  echo "$picked_id" >"$state_dir/session-id"
  echo "$picked_name" >"$state_dir/session-name"
  ;;
*)
  echo "Usage: agent-sidebar [launch|new|load]" >&2
  exit 1
  ;;
esac

cd "$work_dir" || exit 1

if [[ $agent == claude ]]; then
  session=$(cat "$state_dir/session-id" 2>/dev/null)
  if ! valid_uuid "$session"; then
    new_session
    session=$(<"$state_dir/session-id")
  fi
  name=$(cat "$state_dir/session-name" 2>/dev/null)
  [[ -n $name ]] || name=$(date '+%Y-%m-%d %H:%M')

  # Only a session with a message in it can be resumed; one with none yet
  # starts under the same id.
  file=$(transcript "$session")
  elsewhere=("$claude_dir"/projects/*/"$session".jsonl)
  if [[ -n $file ]] && grep -q '"type":"user"' "$file"; then
    command=(claude --resume "$session")
  elif [[ -n $file || -f ${elsewhere[0]} ]]; then
    # No message yet, or filed under another folder (Claude won't resume it
    # here): start a fresh session (with the same name) rather than reuse the id.
    new_session "$name"
    command=(claude --session-id "$(<"$state_dir/session-id")" --name "$(<"$state_dir/session-name")")
  else
    command=(claude --session-id "$session" --name "$name")
  fi
else
  command=(omarchy-agent --inline)
fi

# Hold the lock until the window exists (cold starts can be slow: up to a
# minute) and has stayed open a moment, so an agent that fails at once is
# reported, and a second press meanwhile can't start a second agent on the
# same session; the terminal mustn't inherit the lock.
omarchy-launch-tui --app-id="$class" "${command[@]}" 9>&- &
for _ in {1..600}; do
  if window_open; then
    sleep 1
    window_open && exit 0
    break
  fi
  sleep 0.1
done
notify "The agent didn't stay open; try running it with SUPER + SHIFT + CTRL + A to see why"
